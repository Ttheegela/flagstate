# Copy to agent/.env and fill in. Never commit agent/.env.
# Daytona: app.daytona.io > API Keys
DAYTONA_API_KEY=
# Anchor: app.anchorbrowser.io > API Keys
ANCHOR_API_KEY=
# Arize AX: Settings > API Keys (space id is in the URL / Space Config)
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=flagstate
# ElevenLabs: elevenlabs.io > Developers > API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# SurrealDB Agent Memory: studio.surrealdb.com > Agent Memory > context > Connect
SURREAL_MEMORY_URL=
SURREAL_MEMORY_TOKEN=
# AWS workshop account: event dashboard > Get AWS CLI credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=
